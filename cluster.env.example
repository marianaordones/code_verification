# Optional. The preparation job installs/builds everything automatically.
# Copy to cluster.env only to override defaults; do not save tokens here.

# export CLUSTER_PYTHON=/absolute/path/to/python3.12
# export HF_HOME="${HOME}/.cache/huggingface"
# Optional node-local scratch if /tmp and /var/tmp lack space/execution support.
# export CLUSTER_BUILD_TMP=/path/to/node-local/scratch
# Optional short node-local directory for vLLM Unix/IPC sockets (not HOME/CIFS).
# Normally /tmp or /var/tmp is selected and tested automatically.
# export CLUSTER_IPC_TMP=/path/to/short/local/scratch

# Reuse existing tools: set ALL THREE absolute paths, or leave all unset.
# export VERUS_BIN=/absolute/path/verus/source/target-verus/release/verus
# export Z3_BIN=/absolute/path/verus/source/z3
# export LYNETTE_BIN=/absolute/path/code_verification/tools/lynette/source/target/release/lynette

# Future repetitions can use a saved resolved requirements file. Its hash
# creates a separate package cache, without overwriting the original one.
# export CLUSTER_REQS="${SLURM_SUBMIT_DIR}/requirements-cluster-resolved.txt"
